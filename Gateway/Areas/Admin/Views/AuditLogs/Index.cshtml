@model Gateway.Models.PaginatedList<ITElectiveSSO.Models.AuditLog>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Audit Logs";
}

<style>
    body {
        background-color: #f0f4f9;
    }

    .dark-header {
        background-color: #101625 !important;
        border-radius: 10px;
        color: #ffffff;
        padding: 16px 24px;
    }

    .dark-card {
        background-color: #101625 !important;
        border-radius: 10px;
        border: none;
        color: #ffffff;
    }

    .form-dark-input {
        background-color: #ffffff;
        border: 1px solid #ced4da;
        color: #000000;
        border-radius: 6px;
        padding: 6px 12px;
        width: 100%;
        max-width: 300px;
    }

    /* Table styling matching dark card background */
    .custom-audit-table {
        width: 100%;
        border-collapse: collapse;
        background-color: transparent;
    }

        .custom-audit-table thead tr {
            background-color: transparent !important;
        }

        .custom-audit-table th {
            color: #ffffff !important;
            font-weight: 600;
            padding: 12px 16px;
            border-bottom: 1px solid #2a3447;
            text-align: left;
        }

        .custom-audit-table td {
            color: #ffffff !important;
            padding: 12px 16px;
            border-bottom: 1px solid #2a3447;
            vertical-align: middle;
        }

    .btn-azure-submit {
        background-color: #0088cc;
        color: #ffffff;
        border: none;
        font-weight: 600;
        padding: 6px 20px;
        border-radius: 5px;
    }

        .btn-azure-submit:hover {
            background-color: #0077b5;
            color: #ffffff;
        }

    .btn-cancel-red {
        background-color: #e55353;
        color: #ffffff;
        border: none;
        font-weight: 600;
        padding: 6px 20px;
        border-radius: 5px;
        text-decoration: none;
    }

        .btn-cancel-red:hover {
            background-color: #d93737;
            color: #ffffff;
        }

    .pagination-text-link {
        color: #ffffff;
        font-weight: 600;
        text-decoration: none;
        font-size: 0.95rem;
    }

        .pagination-text-link:hover:not(.disabled) {
            color: #0088cc;
            text-decoration: underline;
        }

        .pagination-text-link.disabled {
            color: #6c757d !important;
            cursor: not-allowed;
            pointer-events: none;
            text-decoration: none;
        }
</style>

<div class="container-fluid px-4 py-3">
    <!-- Header -->
    <div class="dark-header mb-3 shadow-sm">
        <h3 class="fw-bold mb-0">Audit Logs</h3>
    </div>

    <!-- Main Content Card -->
    <div class="dark-card p-4 shadow w-100">
        <!-- Filter Form -->
        <form method="get" class="mb-4">
            <div class="row g-4 align-items-center">
                <div class="col-12 col-md-5">
                    <label for="fromDate" class="form-label fw-bold text-white mb-2">From</label>
                    <input type="date" id="fromDate" name="fromDate" value="@ViewData["FromDate"]" class="form-control form-dark-input" />
                </div>
                <div class="col-12 col-md-5">
                    <label for="toDate" class="form-label fw-bold text-white mb-2">To</label>
                    <input type="date" id="toDate" name="toDate" value="@ViewData["ToDate"]" class="form-control form-dark-input" />
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 mt-3">
                <button type="submit" class="btn btn-azure-submit">Filter</button>
                <a asp-action="Index" class="btn btn-cancel-red">Clear</a>
            </div>
        </form>

        <!-- Audit Table -->
        <div class="table-responsive">
            <table class="custom-audit-table">
                <thead>
                    <tr>
                        <th style="width: 20%;">Timestamp</th>
                        <th style="width: 20%;">Action</th>
                        <th style="width: 45%;">Details</th>
                        <th style="width: 15%;">IP Address</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var log in Model)
                        {
                            <tr>
                                <td>@log.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</td>
                                <td>@log.Action</td>
                                <td>@log.Details</td>
                                <td>@log.IpAddress</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center text-white py-4">No audit logs found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Text-link Pagination Controls -->
        @{
            var hasPrev = Model?.HasPreviousPage ?? false;
            var hasNext = Model?.HasNextPage ?? false;
            var pageIdx = Model?.PageIndex ?? 1;

            var prevClass = !hasPrev ? "disabled" : "";
            var nextClass = !hasNext ? "disabled" : "";
        }
        <div class="d-flex align-items-center gap-4 pt-4">
            <a asp-action="Index"
               asp-route-pageIndex="@(pageIdx - 1)"
               asp-route-fromDate="@ViewData["FromDate"]"
               asp-route-toDate="@ViewData["ToDate"]"
               class="pagination-text-link @prevClass">
                Previous
            </a>
            <a asp-action="Index"
               asp-route-pageIndex="@(pageIdx + 1)"
               asp-route-fromDate="@ViewData["FromDate"]"
               asp-route-toDate="@ViewData["ToDate"]"
               class="pagination-text-link @nextClass">
                Next
            </a>
        </div>
    </div>
</div>

