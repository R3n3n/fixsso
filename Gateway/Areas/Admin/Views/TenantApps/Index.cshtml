<!-- CABARDO -->
@model IEnumerable<ITElectiveSSO.Models.TenantApp>

@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Tenant App Management";
}

<style>
    body {
        background-color: #f0f4f9;
    }

    .dark-card {
        background-color: #101625 !important;
        border-radius: 10px;
        border: none;
        color: #ffffff;
    }

    .dark-header {
        background-color: #101625 !important;
        border-radius: 10px;
        color: #ffffff;
        padding: 16px 24px;
    }

    .custom-dark-table {
        width: 100%;
        color: #ffffff;
        background-color: transparent !important;
        border-collapse: separate;
        border-spacing: 0;
    }

        .custom-dark-table th {
            color: #8a99ad;
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 0.5px;
            border-bottom: 1px solid #232d3f;
            padding: 16px 12px;
            background-color: transparent !important;
        }

        .custom-dark-table td {
            border-bottom: 1px solid #1a2232;
            padding: 16px 12px;
            vertical-align: middle;
            color: #d1d5db;
            background-color: transparent !important;
        }

    .btn-azure {
        background-color: #0088cc;
        color: #ffffff;
        border: none;
        font-weight: 600;
    }

        .btn-azure:hover {
            background-color: #0077b5;
            color: #ffffff;
        }

    .btn-view-blue {
        background-color: #0088cc;
        color: #ffffff;
        border: none;
        padding: 6px 16px;
        border-radius: 5px;
        font-size: 0.85rem;
        font-weight: 600;
        text-decoration: none;
        display: inline-block;
    }

    .btn-delete-red {
        background-color: #e55353;
        color: #ffffff;
        border: none;
        padding: 6px 16px;
        border-radius: 5px;
        font-size: 0.85rem;
        font-weight: 600;
    }

    .badge-active-green {
        background-color: #00c853;
        color: #ffffff;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 6px;
    }

    .badge-suspended-gray {
        background-color: #6c757d;
        color: #ffffff;
        font-weight: 600;
        padding: 6px 14px;
        border-radius: 6px;
    }

    .search-input-dark {
        border-radius: 6px;
        border: none;
        padding-left: 38px;
        background-color: #ffffff;
        color: #000000;
    }

    .search-icon-inside {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        z-index: 10;
        color: #6c757d;
    }

    .modal-dark-content {
        background-color: #182030;
        color: #ffffff;
        border: 1px solid #2a3447;
        border-radius: 8px;
    }

    .modal-dark-input {
        background-color: #ffffff;
        border: 1px solid #ced4da;
        color: #000000;
        border-radius: 4px;
    }

    .btn-modal-cancel {
        background-color: #6c757d;
        color: #ffffff;
        border: none;
    }
</style>

<div class="container-fluid px-4 py-3">
    <div class="dark-header mb-3 shadow-sm">
        <h3 class="fw-bold mb-0">Tenant App Management</h3>
    </div>

    <!-- LLORENTE -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger alert-dismissible fade show mb-3" role="alert">
            <div asp-validation-summary="All" class="mb-0 fw-medium"></div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="dark-card p-4 shadow">
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom border-secondary border-opacity-25">
            <form method="get" asp-action="Index" class="position-relative" style="width: 320px;">
                <i class="bi bi-search search-icon-inside"></i>
                <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control search-input-dark" placeholder="Search by App Name">
            </form>
            <button type="button" class="btn btn-azure px-3 py-2 rounded-2" data-bs-toggle="modal" data-bs-target="#createAppModal">+ Add New App</button>
        </div>

        <div class="table-responsive">
            <table class="custom-dark-table align-middle">
                <thead>
                    <tr>
                        <th class="ps-2" style="width: 25%;">APP NAME</th>
                        <th style="width: 30%;">RETURN URL</th>
                        <th style="width: 15%;">STATUS</th>
                        <th class="text-center" style="width: 15%;">ACTIVE TOGGLE</th>
                        <th class="text-end pe-2" style="width: 15%;">ACTIONS</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        @foreach (var app in Model)
                        {
                            <tr>
                                <td class="ps-2 fw-medium text-white">@app.Name</td>
                                <td>@app.ReturnUrl</td>
                                <td>
                                    <!-- Dynamic Badge ID -->
                                    <span id="badge-@app.Id" class="badge @(app.IsActive ? "badge-active-green" : "badge-suspended-gray")">
                                        @(app.IsActive ? "Active" : "Suspended")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <!-- Dynamic ON/OFF Label ID -->
                                    <span id="toggleLabel-@app.Id" class="me-2 fw-bold small @(app.IsActive ? "text-light" : "text-secondary")">
                                        @(app.IsActive ? "ON" : "OFF")
                                    </span>

                                    <!-- Task: Inline Active/Inactive Switch Toggle -->
                                    <div class="form-check form-switch d-inline-block align-middle mb-0">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               role="switch"
                                               id="switch-@app.Id"
                                               onchange="handleToggle(@app.Id, this)"
                                               @(app.IsActive ? "checked" : "")
                                               style="cursor: pointer;" />
                                    </div>
                                </td>
                                <td class="text-end pe-2">
                                    <button type="button" class="btn btn-view-blue me-2" data-bs-toggle="modal" data-bs-target="#editAppModal-@app.Id">Edit</button>
                                    <button type="button" class="btn btn-delete-red" data-bs-toggle="modal" data-bs-target="#deleteAppModal-@app.Id">Delete</button>
                                    <div class="modal fade text-start" id="editAppModal-@app.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content modal-dark-content shadow-lg">
                                                <div class="modal-header border-0 pb-0">
                                                    <h5 class="modal-title fw-bold">Edit Tenant App</h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <form asp-action="Edit" asp-route-id="@app.Id" method="post">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="Id" value="@app.Id" />
                                                    <div class="modal-body">
                                                        <div class="mb-3">
                                                            <label class="form-label fw-semibold small text-light">Application Name</label>
                                                            <input type="text" name="Name" value="@app.Name" class="form-control modal-dark-input" required />
                                                        </div>
                                                        <div class="mb-3">
                                                            <label class="form-label fw-semibold small text-light">Return URL</label>
                                                            <input type="url" name="ReturnUrl" value="@app.ReturnUrl" class="form-control modal-dark-input" placeholder="https://example.com/callback" required />
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-0 pt-0">
                                                        <button type="button" class="btn btn-modal-cancel px-3" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-azure px-3">Save Changes</button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>

                                    @*leal*@
                                    <div class="modal fade text-start" id="deleteAppModal-@app.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content modal-dark-content shadow-lg">
                                                <div class="modal-header border-0 pb-0">
                                                    <h5 class="modal-title fw-bold text-white d-flex align-items-center">
                                                        <span class="bg-danger text-white rounded-circle d-inline-flex justify-content-center align-items-center me-2" style="width:24px; height:24px; font-size:14px;">!</span> Confirm Deletion
                                                    </h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <p class="mb-0 text-light">
                                                        Are you sure you want to delete <strong>@app.Name</strong>?<br />
                                                        <span class="text-secondary small">This action cannot be undone.</span>
                                                    </p>
                                                </div>
                                                <div class="modal-footer border-0 pt-0">
                                                    <button type="button" class="btn btn-modal-cancel px-3" data-bs-dismiss="modal">Cancel</button>
                                                    <form asp-action="Delete" asp-route-id="@app.Id" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-delete-red px-3">Delete</button>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }

                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">No tenant apps found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@*MANZANO*@
<div class="modal fade text-start" id="createAppModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-dark-content shadow-lg">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Register New Tenant App</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-light">Application Name</label>
                        <input type="text" name="Name" class="form-control modal-dark-input" placeholder="e.g. SalesApp" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold small text-light">Return URL</label>
                        <input type="url" name="ReturnUrl" class="form-control modal-dark-input" placeholder="https://sales.com/callback" required />
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-modal-cancel px-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-azure px-3">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

@*VILLAMOR*@
<script>
    function handleToggle(appId, checkbox) {
        const isChecked = checkbox.checked;
        const label = document.getElementById(`toggleLabel-${appId}`);
        const badge = document.getElementById(`badge-${appId}`);

        // Immediately update UI visually without page refresh
        if (isChecked) {
            label.textContent = "ON";
            label.className = "me-2 fw-bold small text-light";
            badge.textContent = "Active";
            badge.className = "badge badge-active-green";
        } else {
            label.textContent = "OFF";
            label.className = "me-2 fw-bold small text-secondary";
            badge.textContent = "Suspended";
            badge.className = "badge badge-suspended-gray";
        }

        // Send background call to update status in DB
        fetch(`/Admin/TenantApps/ToggleActive/${appId}`, {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest'
            }
        }).catch(err => {
            console.log("Status updated visually.");
        });
    }
</script>
